# Current xsos runtime configuration template.
# Copy to /etc/isarmg/xsos.env, replace the administrator password and keep mode 0600.
XSOS_DATABASE_URL=sqlite:///var/lib/isarmg/xsos/db/xsos.sqlite3
XSOS_BIND=127.0.0.1:18105
XSOS_DEVELOPMENT=false

XSOS_BOOTSTRAP_ADMIN_USERNAME=admin
XSOS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_BYTES
# 32 random bytes encoded as Base64. Generate once and keep it stable; changing
# this key makes the stored per-instance authorization codes unreadable.
XSOC_AUTHORIZATION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

XSOS_TELEMETRY_QUEUE_CAPACITY=256
XSOS_TELEMETRY_BATCH_SIZE=64
XSOS_TELEMETRY_FLUSH_MILLISECONDS=25
XSOS_TELEMETRY_ENQUEUE_WAIT_MILLISECONDS=10
XSOS_TELEMETRY_REQUEST_TIMEOUT_MILLISECONDS=10000
XSOS_TELEMETRY_SHUTDOWN_DRAIN_MILLISECONDS=15000

XSOS_RAW_RETENTION_DAYS=7
XSOS_AGGREGATE_RETENTION_DAYS=365
XSOS_RETENTION_INTERVAL_SECONDS=300
XSOS_RETENTION_BATCH_SIZE=256
XSOS_RETENTION_MAX_TRANSACTIONS_PER_RUN=12
XSOS_RETENTION_MAX_RUN_MILLISECONDS=2000
XSOS_RETENTION_YIELD_MILLISECONDS=10
